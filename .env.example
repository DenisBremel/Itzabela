# ============================================================
#  VARIABLES DE ENTORNO — Itzabela Flores
#  Copia este archivo como `.env` y completa los valores.
#  Todo lo que empieza con VITE_ viaja al navegador:
#  NUNCA pongas aquí contraseñas ni claves secretas.
# ============================================================

# --- Negocio -------------------------------------------------
# Número de WhatsApp con código de país, solo dígitos.
VITE_WHATSAPP_NUMBER=51935826674
# Teléfono tal como se muestra en pantalla.
VITE_PHONE_DISPLAY=+51 935 826 674
# Correo de contacto (opcional).
VITE_CONTACT_EMAIL=
# Dominio final del sitio, sin barra al final.
VITE_SITE_URL=https://itzabela.com

# --- Supabase (panel de stock) -------------------------------
# Las encuentras en supabase.com → tu proyecto → Settings → API.
# La clave "anon" es pública por diseño: el acceso real lo controlan
# las políticas RLS definidas en supabase/schema.sql.
# Si dejas estas dos vacías, la web funciona igual con el catálogo
# de ejemplo (src/data/products.ts) y el panel queda deshabilitado.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
